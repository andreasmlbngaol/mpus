# Copy to .env for local builds. Never commit .env.
# Gradle reads these (see app/build.gradle.kts). Real environment variables win over .env.

# Base URL of the mpus backend. Also a CI variable of the same name.
API_BASE_URL=https://mpus.booroong.online

# Release signing. Only needed to build a signed release locally; in CI these come from
# repository secrets of the same name. Leave unset for debug builds.
# MPUS_KEYSTORE_FILE=/absolute/path/to/mpus-release.jks
# MPUS_KEYSTORE_PASSWORD=
# MPUS_KEY_ALIAS=mpus
# MPUS_KEY_PASSWORD=
